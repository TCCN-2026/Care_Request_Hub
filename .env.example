# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key. Server-only. NEVER expose this to the browser or commit
# it. Used by the seed script and trusted background jobs only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App branding / settings ------------------------------------------------
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PRIMARY_WEBSITE_URL=https://example.com
NEXT_PUBLIC_LOGO_URL=/logo-placeholder.svg

# --- Email (transactional) --------------------------------------------------
# Optional for local dev. When unset, the app logs notification emails to
# the console instead of sending them (see src/lib/notifications).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Care Request Hub <notifications@example.com>"

# --- HighLevel integration (optional, disabled by default) -----------------
# Leave unset for local development - the integration layer falls back to a
# no-op client. See GHL_INTEGRATION.md.
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_WEBHOOK_SECRET=
