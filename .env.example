# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real credentials.

# --- Supabase --------------------------------------------------------------
# Project Settings -> API in your Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key. Server-only. NEVER expose this to the browser or commit
# it. Used by the seed script and trusted background jobs only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- App branding / settings ------------------------------------------------
# Product name, tagline and colour palette live in src/lib/settings.ts, not
# here - it's the single file to edit for a full rebrand. These env vars
# only cover the handful of values that reasonably differ per environment.
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_PRIMARY_WEBSITE_URL=https://thecareconnector.co.uk
# Leave unset to show a plain text wordmark (the current default). To use a
# real logo image, add the file under public/brand/ (e.g. public/brand/logo.png)
# and set this to its public path, e.g. /brand/logo.png.
NEXT_PUBLIC_LOGO_URL=

# --- Email (transactional) --------------------------------------------------
# Optional for local dev. When unset, the app logs notification emails to
# the console instead of sending them (see src/lib/notifications).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS="Care Procurement Hub <notifications@example.com>"

# --- HighLevel integration (optional, disabled by default) -----------------
# Leave unset for local development - the integration layer falls back to a
# no-op client. See GHL_INTEGRATION.md.
HIGHLEVEL_API_KEY=
HIGHLEVEL_LOCATION_ID=
HIGHLEVEL_WEBHOOK_SECRET=

# --- Whole-site password gate (optional) ------------------------------------
# Leave unset for local development and any deploy that should be fully open
# (the gate is a no-op without it). Set this on a deployment to require a
# shared password before anything on the site loads - for keeping an early
# deploy restricted to trusted testers rather than the public. See the
# "Deployment" section in README.md.
SITE_PASSWORD=
